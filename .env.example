# Copy to .env and adjust. Docker Compose reads this file automatically.

# Default compose profile: dev (hot reload) or prod (production images).
COMPOSE_PROFILES=dev

# Where the frontend looks for the API. Point it at a LAN address to test on a
# real phone, e.g. http://192.168.1.20:8080/api/v1
# The dev profile reads this at request time; the prod profile bakes it into the
# bundle, so changing it there needs a rebuild.
API_URL=http://localhost:8080/api/v1

# Set to true only if backend hot reload misses your edits — inotify events do
# not always cross the bind mount on Docker Desktop.
# WATCHFILES_FORCE_POLLING=true
